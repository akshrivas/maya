# Settings for running locally against the Firebase emulators (no real accounts needed).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-maya
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-maya.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-maya.appspot.com
ANTHROPIC_API_KEY=
